# Copy to .env and fill from your Supabase project (Project Settings → API).
# Both are PUBLIC values (they ship in the browser bundle) — safe to expose.
# Per-user data is protected by Row-Level Security on the server, not by secrecy.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
