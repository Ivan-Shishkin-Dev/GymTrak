{
  "name": "gymtrak",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Personal offline-first workout tracker (ULULUL split) — installable PWA",
  "scripts": {
    "dev": "vite --port 5180 --strictPort",
    "build": "tsc -b && vite build",
